<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mia_hand_with_wrist_robot">

  <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
  <xacro:arg name="wrist_port" default="/dev/ttyUSB1"/>
  <xacro:arg name="laterality" default="right"/>
  <xacro:arg name="joint_limits_config_file" default="joint_limits_default.yaml"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_mock_hardware" default="false"/>

  <!-- Importing Mia Hand description (visual/collision) -->
  <xacro:include filename="$(find mia_hand_description)/urdf/mia_hand.urdf.xacro"/>

  <!-- Importing Mia Hand ROS2 control macro -->
  <xacro:include filename="$(find mia_hand_ros2_control)/description/ros2_control/mia_hand.ros2_control.xacro"/>

  <!-- Importing Wrist Motor ROS2 control macro -->
  <xacro:include filename="$(find mia_hand_ros2_control)/description/ros2_control/wrist_motor.ros2_control.xacro"/>

  <link name="world"/>

  <!-- Wrist link: intermediary between world and the hand palm -->
  <link name="wrist_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Wrist rotation joint: world -> wrist_link -->
  <joint name="wrist_rotation" type="revolute">
    <parent link="world"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="2.0" velocity="2.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- Mia Hand: attached to wrist_link instead of world -->
  <xacro:mia_hand
    laterality="$(arg laterality)"
    joint_limits_config_file="$(arg joint_limits_config_file)"
    parent="wrist_link"
    prefix="$(arg prefix)">
    <xacro:if value="${'right' == '$(arg laterality)'}">
      <origin xyz="0 0 0.2" rpy="1.57 0 0"/>
    </xacro:if>
    <xacro:if value="${'left' == '$(arg laterality)'}">
      <origin xyz="0 0 0.2" rpy="1.57 3.14 0"/>
    </xacro:if>
  </xacro:mia_hand>

  <!-- Mia Hand ROS2 Control -->
  <xacro:mia_hand_ros2_control 
    name="MiaHand" 
    prefix="$(arg prefix)"
    serial_port="$(arg serial_port)"
    use_mock_hardware="$(arg use_mock_hardware)"/>

  <!-- Wrist Motor ROS2 Control -->
  <xacro:wrist_motor_ros2_control
    name="WristMotor"
    prefix="$(arg prefix)"
    port_name="$(arg wrist_port)"
    use_mock_hardware="$(arg use_mock_hardware)"/>

</robot>