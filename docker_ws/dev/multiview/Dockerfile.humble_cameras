# syntax=docker/dockerfile:1
FROM docker.io/ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-realsense2-camera \
        ros-humble-realsense2-description \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-rmw-fastrtps-cpp \
        ros-humble-tf2-sensor-msgs \
        ros-humble-sensor-msgs-py \
        ros-humble-launch-ros \
        python3-pip \
        usbutils \
        v4l-utils

RUN pip install numpy

WORKDIR /ros_ws
COPY launch/ /ros_ws/launch/
COPY nodes/  /ros_ws/nodes/
COPY scripts/ /ros_ws/scripts/
RUN chmod +x /ros_ws/scripts/*.sh

# FastDDS (rmw_fastrtps_cpp) is the ROS2 Humble default and the only
# RMW reliably passing intra-container peer discovery on this kernel/Docker stack.
# CycloneDDS is kept as an installable alternative but must be opted into at runtime:
#   RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
#ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
#ENV ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && exec \"$@\"", "--"]
CMD ["/ros_ws/scripts/realsense_ros_probe.sh"]
