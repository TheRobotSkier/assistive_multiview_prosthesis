# syntax=docker/dockerfile:1
# Extends ROS 2 Jazzy with the mindrove EMG classifier.
# Used by the mindrove_emg_ros compose service.
FROM docker.io/ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        python3-pip libusb-1.0-0

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --break-system-packages \
        mindrove numpy scipy scikit-learn joblib

WORKDIR /app
COPY emg_classifier/ /app/emg_classifier/
COPY scripts/ /app/scripts/
RUN mkdir -p /app/data /app/models

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

CMD ["python", "scripts/run_classifier.py"]
