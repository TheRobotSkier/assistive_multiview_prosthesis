# Combined image: Python 3.8 inference server + ROS2 Jazzy node (Python 3.12).
#
# Build context: docker_ws/dev/pc_segmentation/  (the MinkowskiEngine repo root)
# The local ME source is COPY-ed in to build the CPU-only wheel.
#
# Two processes run at container start (see docker/entrypoint.sh):
#   python3.8  /nodes/inference_server.py    (ME + InterObject3D model)
#   python3    /nodes/segmentation_ros2_node.py  (ROS2 subscriber/publisher)

FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive

# ── System packages ─────────────────────────────────────────────────────────
# deadsnakes PPA for Python 3.8 on Ubuntu 24.04 (Noble)
# NOTE: do not use inline shell comments inside apt-get \ continuation blocks
RUN apt-get update && apt-get install -y software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
        python3.8 \
        python3.8-dev \
        python3.8-distutils \
        python3-pip \
        git \
        ninja-build \
        cmake \
        build-essential \
        libopenblas-dev \
        wget \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# ── pip for Python 3.8 ──────────────────────────────────────────────────────
RUN wget -q https://bootstrap.pypa.io/pip/3.8/get-pip.py \
    && python3.8 get-pip.py \
    && rm get-pip.py

# ── Python 3.8: torch (CPU-only) + numpy ────────────────────────────────────
RUN python3.8 -m pip install --no-cache-dir "numpy<2"
RUN python3.8 -m pip install --no-cache-dir \
    torch==1.12.1+cpu \
    torchvision==0.13.1+cpu \
    -f https://download.pytorch.org/whl/torch_stable.html

# ── MinkowskiEngine (CPU-only, built from local source) ─────────────────────
COPY . /MinkowskiEngine-src
ENV MAX_JOBS=4
RUN cd /MinkowskiEngine-src \
    && python3.8 setup.py install --blas=openblas --cpu_only \
    && cd / && rm -rf /MinkowskiEngine-src

# ── Python 3.8: InterObject3D runtime deps + Flask ──────────────────────────
RUN python3.8 -m pip install --no-cache-dir \
    "open3d>=0.12.0" \
    trimesh \
    pyviz3d \
    scipy \
    scikit-learn \
    plyfile \
    tqdm \
    pandas \
    transforms3d \
    matplotlib \
    flask

# ── InterObject3D source ─────────────────────────────────────────────────────
RUN git clone https://github.com/theodorakontogianni/InterObject3D /app \
    && cd /app && git checkout 827b350

# ── Python 3.12 (ROS2 node) deps ────────────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages requests

# ── Node scripts and entrypoint ─────────────────────────────────────────────
COPY nodes/ /nodes/
COPY docker/entrypoint.ros2.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# ── Optional: bake weights into image at build time ──────────────────────────
ARG DOWNLOAD_WEIGHTS=0
RUN if [ "$DOWNLOAD_WEIGHTS" = "1" ]; then \
        mkdir -p /weights && \
        wget -q \
          https://omnomnom.vision.rwth-aachen.de/data/3d_inter_obj_seg/scannet_official/weights/weights_exp14_14.pth \
          -O /weights/weights_exp14_14.pth; \
    fi

ENTRYPOINT ["/entrypoint.sh"]
