<!-- Approach scene for realistic preshaping validation.
     The hand starts ~20 cm behind the object, approximating a user
     approaching with their prosthetic hand visible from a head-mounted camera.
     The depth camera (depth_cam_body) is placed where a user's head would be:
     above and behind the hand, looking down at the workspace.
     Relative sphere position in hand frame: (0, 0.11, 0.05)
    Sphere radius = 0.03 m = unit-sphere radius x default pointcloud_scale (0.03). -->
<mujoco model="mia_hand_right approach scene">
  <include file="mia_hand_right_grasp_frame.xml"/>

  <!-- Camera framing: wider extent to capture the approach path -->
  <statistic extent="0.8" center="-0.1 0.1 0.35"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
      width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
      texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 .125" type="plane" material="groundplane"
      conaffinity="15" condim="3"/>

    <!-- Target object: same position as other scenes -->
    <body name="target_sphere_body" pos="-0.1 -0.0499124 0.3100398">
      <geom name="target_sphere" type="sphere" size="0.03"
        rgba="1 0 0 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Head-mounted depth camera.
         Positioned above and behind the hand, looking down at the workspace.
         This approximates where a user's head-mounted camera would be relative
         to the hand and object during an approach-and-grasp task.
         pos=(-0.1, 0.25, 0.55): above the hand, ~25cm behind, ~35cm above object.
         euler=(-2.0, 0, 0): tilted ~115 degrees from horizontal, looking down and forward.
         The 58-degree vertical FOV should capture both hand and object during approach. -->
    <body name="depth_cam_body" pos="-0.1 0.25 0.55" euler="-2.0 0 0">
      <!-- Named site used as the IMU reference point (origin of depth_cam_body) -->
      <site name="imu_site" pos="0 0 0" size="0.005" rgba="0 0 0 0"/>
      <camera
        name="front_depth_cam"
        pos="0 0 0"
        euler="3.14 0 0"
        fovy="58"/>
      <geom name="d435_visual" type="mesh" mesh="d435_body"
        pos="0 0 0" euler="0 0 3.14159"
        contype="0" conaffinity="0" group="0" rgba="0.2 0.2 0.2 1"/>
    </body>
  </worldbody>
</mujoco>
