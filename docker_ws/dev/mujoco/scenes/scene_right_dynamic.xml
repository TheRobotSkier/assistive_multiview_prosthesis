<!-- Dynamic dev scene for grasp_preshaping validation.
     Geometry and initial placements intentionally match the static scene.
     The difference is in the runtime pipeline: downstream consumers are expected
     to use published TFs and live MuJoCo-derived frame information instead of
     hardcoded transforms.
     Relative sphere position in hand frame: (0, 0.11, 0.05)
     Sphere radius = 0.03 m = sphere.xyz unit radius × default pointcloud_scale (0.03). -->
<mujoco model="mia_hand_right dynamic scene">
  <include file="mia_hand_right_grasp_frame.xml"/>

  <!-- Camera framing: centre between the default hand pose and the target sphere. -->
  <statistic extent="0.4" center="-0.1 -0.025 0.255"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
      width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
      texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 .125" type="plane" material="groundplane"
      conaffinity="15" condim="3"/>
    <body name="target_sphere_body" pos="-0.1 -0.0499124 0.3100398">
      <geom name="target_sphere" type="sphere" size="0.03"
        rgba="1 0 0 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Dynamic-mode consumers should use the camera TF and world-frame point cloud
         rather than any static camera transform constants. -->
    <body name="depth_cam_body" pos="-0.08 -0.46 0.36" euler="-1.67079632679 0 0">
      <camera
        name="front_depth_cam"
        pos="0 0 0"
        euler="3.14 0 0"
        fovy="58"/>
      <geom name="d435_visual" type="mesh" mesh="d435_body"
        pos="0 0 0" euler="0 0 3.14159"
        contype="0" conaffinity="0" group="0" rgba="0.2 0.2 0.2 1"/>
    </body>
  </worldbody>
</mujoco>
