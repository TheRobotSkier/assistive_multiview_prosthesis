# /etc/udev/rules.d/99-wrist-motor.rules
# Dynamixel wrist motor USB serial device
# Replace <DXL_VENDOR_ID> and <DXL_PRODUCT_ID> with actual values from lsusb
# To discover: unplug device, run `lsusb`, plug device, run `lsusb`, note the new entry
# Then set the vendor/product IDs below (4-digit hex, lowercase)
#
# Example for FTDI-based adapter: ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001"
# Example for U2D2 (CP210x): ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60"
#
# SUBSYSTEM=="tty", ATTRS{idVendor}=="<DXL_VENDOR_ID>", ATTRS{idProduct}=="<DXL_PRODUCT_ID>", SYMLINK+="wrist_motor"
#
# Placeholder: matches any ttyUSB device as /dev/wrist_motor (override after discovering IDs)
# SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{devnum}=="2", SYMLINK+="wrist_motor"
