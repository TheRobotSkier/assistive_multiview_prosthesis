<?xml version="1.0"?>
<package format="3">
  <name>segmentation_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 bridge node for InterObject3D point cloud segmentation</description>
  <maintainer email="daniel@example.com">Daniel</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
