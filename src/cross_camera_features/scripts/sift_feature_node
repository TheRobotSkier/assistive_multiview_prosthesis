#!/usr/bin/env python3
"""Launcher for sift_feature_node (cross_camera_features).

Bypasses the setuptools console_scripts entry-point wrapper (which uses
importlib.metadata.distribution() to find package metadata) and directly
imports the module.  This avoids PackageNotFoundError / ModuleNotFoundError
when colcon install does not place dist-info in a location importlib.metadata
can discover.

Usage
-----
    sift_feature_node --ros-args ...
"""

import sys

from cross_camera_features.sift_feature_node import main

if __name__ == "__main__":
    sys.exit(main())
