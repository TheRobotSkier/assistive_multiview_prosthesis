# ── User / Environment ────────────────────────────────────────────────────────
USER_UID=1000
USER_GID=1000
DISPLAY=:0

# ── Hardware device paths ────────────────────────────────────────────────────
MIA_SERIAL_PORT=/dev/ttyUSB1
WRIST_PORT=/dev/ttyUSB0

# ── Bluetooth ────────────────────────────────────────────────────────────────
HAPTIC_BT_ADDR1=84:2E:14:09:E1:4E

# ── Segmentation ─────────────────────────────────────────────────────────────
INFERENCE_SERVER_PORT=5678
