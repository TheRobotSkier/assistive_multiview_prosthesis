# ── User / Environment ────────────────────────────────────────────────────────
USER_UID=1000
USER_GID=1000
DISPLAY=:0

# ── Hardware device paths ────────────────────────────────────────────────────
# Preferred: persistent udev symlinks (see docs/hardware_device_naming.md)
# Fall back to /dev/ttyUSB0 (MIA) and /dev/ttyUSB1 (wrist) if udev rules not installed
MIA_SERIAL_PORT=/dev/mia_hand
WRIST_PORT=/dev/wrist_motor

# ── Bluetooth ────────────────────────────────────────────────────────────────
HAPTIC_BT_ADDR1=84:2E:14:09:E1:4E

# ── Segmentation ─────────────────────────────────────────────────────────────
INFERENCE_SERVER_PORT=5678

# ── Camera serials (D435i) ──────────────────────────────────────────────────
# Override the defaults in sensor_fusion_bringup/config/d435i_cameras.yaml.
# Find serial numbers with: rs-enumerate-devices | grep Serial
CAM_HEAD_SERIAL=
CAM_ARM_SERIAL=
