# Slim EMG container for collection, training, live inference, and latency benchmarking.

FROM docker.io/library/ros:jazzy-ros-core-noble

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        gosu \
        python3-colcon-common-extensions \
        python3-joblib \
        python3-pip \
        python3-pytest \
        python3-rosdep \
        python3-scipy \
        ros-jazzy-rclpy \
        ros-jazzy-ros2cli \
        ros-jazzy-std-msgs \
        usbutils \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --break-system-packages \
        mindrove \
        scikit-learn

ARG USER_UID=1000
ARG USER_GID=1000

RUN if id -u ${USER_UID} >/dev/null 2>&1; then \
        EXISTING_USER=$(getent passwd ${USER_UID} | cut -d: -f1) && \
        EXISTING_GROUP=$(getent group ${USER_GID} | cut -d: -f1) && \
        groupmod -n prosthesis "$EXISTING_GROUP" 2>/dev/null || true && \
        usermod -l prosthesis -d /home/prosthesis -m "$EXISTING_USER" 2>/dev/null || true; \
    else \
        groupadd -g ${USER_GID} prosthesis 2>/dev/null || true && \
        useradd -m -u ${USER_UID} -g ${USER_GID} -s /bin/bash prosthesis; \
    fi \
    && usermod -aG dialout prosthesis 2>/dev/null || true \
    && echo "prosthesis ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/prosthesis

WORKDIR /prosthesis_ws

COPY src/emg_bridge/package.xml /tmp/emg_bridge_package.xml
RUN mkdir -p /prosthesis_ws/src/emg_bridge \
    && cp /tmp/emg_bridge_package.xml /prosthesis_ws/src/emg_bridge/package.xml \
    && rm -rf /prosthesis_ws/src

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV ROS_DOMAIN_ID=0

RUN mkdir -p /app/data /app/models /prosthesis_ws/build /prosthesis_ws/install /prosthesis_ws/log \
    && chown -R prosthesis:prosthesis /app /prosthesis_ws

USER prosthesis

RUN echo "source /opt/ros/jazzy/setup.bash" >> /home/prosthesis/.bashrc \
    && echo 'if [ -f /prosthesis_ws/install/setup.bash ]; then source /prosthesis_ws/install/setup.bash; fi' >> /home/prosthesis/.bashrc

USER root
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]
