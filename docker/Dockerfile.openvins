# OpenVINS container for dual D435i visual-inertial odometry
# Extends the base prosthesis image with OpenVINS build dependencies.
# Usage:
#   podman build -f docker/Dockerfile.openvins -t prosthesis-openvins:latest .
FROM docker.io/osrf/ros:jazzy-desktop

ENV DEBIAN_FRONTEND=noninteractive

# ── System + OpenVINS build dependencies ─────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        # Base utilities
        libserial-dev \
        python3-pip \
        usbutils \
        # ROS 2 transport
        ros-jazzy-cyclonedds \
        ros-jazzy-rmw-cyclonedds-cpp \
        # OpenVINS native dependencies
        libeigen3-dev \
        libboost-all-dev \
        libceres-dev \
        libopencv-dev \
        # ROS image transport (for feature tracking subscribers)
        ros-jazzy-cv-bridge \
        ros-jazzy-image-transport \
        # RealSense SDK + ROS driver
        ros-jazzy-librealsense2 \
        ros-jazzy-realsense2-camera \
        ros-jazzy-realsense2-description \
        # RViz for visualization
        ros-jazzy-rviz2 \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ──────────────────────────────────────────────────────
RUN python3 -m pip install --no-cache-dir --break-system-packages \
        dynamixel-sdk \
        requests \
        pyyaml \
        pyserial

# ── User setup ───────────────────────────────────────────────────────────────
ARG USER_UID=1000
ARG USER_GID=1000

RUN if id -u ${USER_UID} >/dev/null 2>&1; then \
        EXISTING_USER=$(getent passwd ${USER_UID} | cut -d: -f1) && \
        usermod -l prosthesis -d /home/prosthesis -m "$EXISTING_USER" 2>/dev/null || true; \
    else \
        groupadd -g ${USER_GID} prosthesis 2>/dev/null || true && \
        useradd -m -u ${USER_UID} -g ${USER_GID} -s /bin/bash prosthesis; \
    fi \
    && usermod -aG dialout prosthesis 2>/dev/null || true

# ── Workspace ────────────────────────────────────────────────────────────────
WORKDIR /prosthesis_ws

# Copy packages (open_vins and realsense-ros are git submodules)
COPY src/ src/
COPY esp32_imu/ esp32_imu/
COPY config/ config/
COPY rviz/ rviz/
COPY scripts/ scripts/

RUN chmod +x scripts/*.sh scripts/*.py 2>/dev/null || true

# ── Build ────────────────────────────────────────────────────────────────────
# Build everything including OpenVINS (ov_msckf) and sensor_fusion_bringup.
# Uses all available CPU cores (unlike Jetson which used -j1).
RUN . /opt/ros/jazzy/setup.sh \
    && apt-get update \
    && rosdep install --from-paths src/ --ignore-src -r -y \
    && rm -rf /var/lib/apt/lists/* \
    && colcon build \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
        --packages-up-to ov_msckf sensor_fusion_bringup

# ── Runtime ──────────────────────────────────────────────────────────────────
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV ROS_DOMAIN_ID=0
ENV LD_LIBRARY_PATH="/prosthesis_ws/install/grasp_preshaping/lib:${LD_LIBRARY_PATH}"

USER prosthesis

# Source the workspace on shell entry
RUN echo "source /opt/ros/jazzy/setup.bash" >> /home/prosthesis/.bashrc \
    && echo "source /prosthesis_ws/install/setup.bash" >> /home/prosthesis/.bashrc

CMD ["/bin/bash"]
