# ── EMG Experiment Container (Python 3.10) ───────────────────────────────────
# Minimal image for NaviFlame — just Python 3.10 + dependencies.
# Source code and NaviFlame are bind-mounted at runtime (see Makefile).
#
# Build:
#   make build-emg-experiments
#
# Run:
#   make emg-naviflame
#   make emg-naviflame-train

FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libusb-1.0-0 libudev1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /prosthesis_ws

# ── NaviFlame dependencies ────────────────────────────────────────────────────
RUN pip install --no-cache-dir \
    numpy \
    opencv-python \
    scikit-learn \
    tensorflow==2.12.0 \
    mindrove \
    keyboard \
    pyyaml

# ── User setup for podman --userns=keep-id ────────────────────────────────────
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd --gid ${USER_GID} prosthesis 2>/dev/null || true && \
    useradd --uid ${USER_UID} --gid ${USER_GID} -m prosthesis

USER prosthesis
ENV HOME=/home/prosthesis
ENV PYTHONPATH="/prosthesis_ws/src/emg_bridge:/prosthesis_ws/NaviFlame"
ENV DISPLAY=:0
ENV OPENCV_OPENCL_RUNTIME=
