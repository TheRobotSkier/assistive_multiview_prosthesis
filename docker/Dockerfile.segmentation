# Multi-capability Docker image for MinkowskiEngine + InterObject3D inference.
# Supports CUDA acceleration when a GPU is available, falls back to CPU otherwise.
# Isolated from the main ROS container — this runs Python 3.8 + PyTorch 1.12.
# The ROS bridge node talks to this container over HTTP.

# Ubuntu 20.04 + CUDA 11.8 toolkit (devel includes nvcc for building MinkowskiEngine).
# CUDA 11.8 is backward-compatible with PyTorch 1.12.1+cu116 wheels.
FROM docker.io/nvidia/cuda:11.8.0-cudnn8-devel-ubuntu20.04

ENV DEBIAN_FRONTEND=noninteractive

# Build tools + Open3D headless runtime requirements + Python 3.8
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.8 \
        python3.8-dev \
        python3-pip \
        git \
        ninja-build \
        cmake \
        build-essential \
        libopenblas-dev \
        wget \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# Make python3.8 the default python and pip
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.8 1 \
    && update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

# Pin numpy<2 before torch to avoid ABI mismatch with torch 1.12
RUN pip install --no-cache-dir "numpy<2"

# PyTorch with CUDA 11.6 support (includes CPU fallback automatically).
# On hosts without a GPU PyTorch falls back to CPU transparently.
RUN pip install --no-cache-dir \
        torch==1.12.1+cu116 \
        torchvision==0.13.1+cu116 \
        -f https://download.pytorch.org/whl/torch_stable.html

# Build MinkowskiEngine.
# Default (CPU_ONLY=0): force CUDA compilation so the container works on GPU
# hosts and transparently falls back to CPU on hosts without a GPU (as long as
# the CUDA runtime libraries are present in the image).
# Set CPU_ONLY=1 at build time for environments that cannot tolerate CUDA libs.
ARG CPU_ONLY=0
COPY MinkowskiEngine/ /MinkowskiEngine-src/MinkowskiEngine/
COPY setup.minkowski.py /MinkowskiEngine-src/setup.py
COPY src/ /MinkowskiEngine-src/src/
COPY pybind/ /MinkowskiEngine-src/pybind/
COPY MANIFEST.in /MinkowskiEngine-src/MANIFEST.in
COPY README.md /MinkowskiEngine-src/README.md
ENV MAX_JOBS=4
RUN cd /MinkowskiEngine-src && \
    if [ "$CPU_ONLY" = "1" ]; then \
        echo "Building MinkowskiEngine CPU_ONLY"; \
        python setup.py install --blas=openblas --cpu_only; \
    else \
        echo "Building MinkowskiEngine with CUDA"; \
        python setup.py install --blas=openblas --force_cuda; \
    fi && \
    cd / && rm -rf /MinkowskiEngine-src

# Python inference dependencies
RUN pip install --no-cache-dir \
        "open3d>=0.12.0" \
        trimesh \
        pyviz3d \
        scipy \
        scikit-learn \
        plyfile \
        tqdm \
        pandas \
        transforms3d \
        matplotlib \
        flask

# Clone InterObject3D (pinned to a known-good commit)
RUN git clone https://github.com/theodorakontogianni/InterObject3D /app && \
    cd /app && git checkout 827b350

WORKDIR /app/InterObject3D/Minkowski/training

# Copy the inference server
COPY nodes/inference_server.py /nodes/inference_server.py

# Weights are expected at /weights/weights_exp14_14.pth
# Downloaded at runtime by the entrypoint script if not present.
# Pre-create dir with world-writable permissions (userns_mode: keep-id maps non-root).
RUN mkdir -p /weights && chmod 777 /weights
ARG DOWNLOAD_WEIGHTS=0
RUN if [ "$DOWNLOAD_WEIGHTS" = "1" ]; then \
        wget -q \
          https://omnomnom.vision.rwth-aachen.de/data/3d_inter_obj_seg/scannet_official/weights/weights_exp14_14.pth \
          -O /weights/weights_exp14_14.pth; \
    fi

COPY docker/entrypoint.inference.sh /entrypoint.inference.sh
RUN chmod +x /entrypoint.inference.sh

ENTRYPOINT ["/entrypoint.inference.sh"]
CMD ["python", "/nodes/inference_server.py"]
