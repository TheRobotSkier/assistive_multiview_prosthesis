# Multi-capability Docker image for MinkowskiEngine + InterObject3D inference.
# Isolated from the main ROS container — this runs Python 3.10 + PyTorch 1.13.
# The ROS bridge node talks to this container over HTTP.
#
# Build args:
#   BACKEND=cuda  → PyTorch CUDA devel image (pre-installed), force CUDA ME build
#   BACKEND=cpu   → Ubuntu 20.04 base image, PyTorch CPU wheels, CPU-only ME build
#
# Platform compatibility:
#   CUDA backend: x86_64 Linux with NVIDIA driver >= 450.80.02, CUDA 11.6 compatible.
#   Jetson/L4T is explicitly NOT supported by this CUDA image.
#   CPU backend: any x86_64 or aarch64 Linux with standard container runtime.

ARG BACKEND=cuda

# ── Base image selection ────────────────────────────────────────────────────
# CUDA: official PyTorch image bundles PyTorch 1.13.1 + CUDA 11.6 + cuDNN 8 +
#        Python 3.10, ninja, cmake, build-essential, numpy — all self-consistent.
FROM docker.io/pytorch/pytorch:1.13.1-cuda11.6-cudnn8-devel AS base-cuda
FROM docker.io/ubuntu:20.04 AS base-cpu

# Select the correct base
FROM base-${BACKEND} AS build-base

ENV DEBIAN_FRONTEND=noninteractive

# Install packages not present in the pytorch base image.
# The CUDA base already has: python3, pip, ninja, cmake, build-essential, git, numpy.
# We only add Open3D headless runtime deps + openblas for MinkowskiEngine.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        libopenblas-dev \
        wget \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# CPU path: install Python 3.8 and build tools (ubuntu:20.04 base has none of these)
# The CUDA base already has all of this, so this only runs for BACKEND=cpu.
RUN if [ ! -x /usr/bin/python ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            python3.8 python3.8-dev python3-pip \
            ninja-build cmake build-essential \
        && rm -rf /var/lib/apt/lists/* \
        && update-alternatives --install /usr/bin/python python /usr/bin/python3.8 1 \
        && update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1; \
    fi

# CPU path: pin numpy<2 before torch to avoid ABI mismatch with torch 1.12.
# The CUDA base already has a compatible numpy from PyTorch 1.13.
RUN if [ ! -x /usr/bin/nvidia-smi ]; then \
        pip install --no-cache-dir "numpy<2"; \
    fi

# ── PyTorch installation (CPU-only) ────────────────────────────────────────
# CUDA variant: PyTorch is already installed in the base image — nothing to do.
FROM build-base AS pytorch-cpu
RUN pip install --no-cache-dir \
        torch==1.12.1+cpu \
        torchvision==0.13.1+cpu \
        -f https://download.pytorch.org/whl/torch_stable.html

# Select the correct PyTorch stage
# For CUDA: pytorch-cuda is just build-base (PyTorch pre-installed)
FROM build-base AS pytorch-cuda
FROM pytorch-${BACKEND} AS final

# ── MinkowskiEngine build ──────────────────────────────────────────────────
# Default (BACKEND=cuda): force CUDA compilation.
# BACKEND=cpu: build without CUDA support, no CUDA libs required at runtime.
ARG BACKEND=cuda
COPY MinkowskiEngine/ /MinkowskiEngine-src/MinkowskiEngine/
COPY setup.minkowski.py /MinkowskiEngine-src/setup.py
COPY src/ /MinkowskiEngine-src/src/
COPY pybind/ /MinkowskiEngine-src/pybind/
COPY MANIFEST.in /MinkowskiEngine-src/MANIFEST.in
COPY README.md /MinkowskiEngine-src/README.md
ENV MAX_JOBS=4
RUN cd /MinkowskiEngine-src && \
    if [ "${BACKEND}" = "cpu" ]; then \
        echo "Building MinkowskiEngine CPU_ONLY"; \
        python setup.py install --blas=openblas --cpu_only; \
    else \
        echo "Building MinkowskiEngine with CUDA"; \
        python setup.py install --blas=openblas --force_cuda; \
    fi && \
    cd / && rm -rf /MinkowskiEngine-src

# ── Python inference dependencies ────────────────────────────────────────────
RUN pip install --no-cache-dir \
        "open3d>=0.12.0" \
        trimesh \
        pyviz3d \
        scipy \
        scikit-learn \
        plyfile \
        tqdm \
        pandas \
        transforms3d \
        matplotlib \
        flask

# Clone InterObject3D (pinned to a known-good commit)
RUN git clone https://github.com/theodorakontogianni/InterObject3D /app && \
    cd /app && git checkout 827b350

WORKDIR /app/InterObject3D/Minkowski/training

# Copy the inference server
COPY nodes/inference_server.py /nodes/inference_server.py

# Weights are expected at /weights/weights_exp14_14.pth
# Downloaded at runtime by the entrypoint script if not present.
# Pre-create dir with world-writable permissions (userns_mode: keep-id maps non-root).
RUN mkdir -p /weights && chmod 777 /weights
ARG DOWNLOAD_WEIGHTS=0
RUN if [ "${DOWNLOAD_WEIGHTS}" = "1" ]; then \
        wget -q \
          https://omnomnom.vision.rwth-aachen.de/data/3d_inter_obj_seg/scannet_official/weights/weights_exp14_14.pth \
          -O /weights/weights_exp14_14.pth; \
    fi

COPY docker/entrypoint.inference.sh /entrypoint.inference.sh
RUN chmod +x /entrypoint.inference.sh

ENTRYPOINT ["/entrypoint.inference.sh"]
CMD ["python", "/nodes/inference_server.py"]
