<CycloneDDS>
  <Domain Id="0">
    <General>
      <Interfaces>
        <NetworkInterface address="10.42.0.1" />
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
      <MulticastRecvNetworkInterfaceAddresses>all</MulticastRecvNetworkInterfaceAddresses>
      <!--
        Prevent IP-level fragmentation.  16 KB keeps each UDP datagram
        well under the Ethernet MTU (~1500 bytes after headers).
      -->
      <FragmentSize>16384B</FragmentSize>
      <Transport>UDP</Transport>
    </General>
    <Discovery>
      <Peers>
        <Peer address="10.42.0.1"/>
        <Peer address="10.42.0.2"/>
      </Peers>
    </Discovery>
    <!-- ── Internal / socket buffer tuning ────────────────────────────────
         SocketReceiveBufferSize: 50 MB — the host receives two 0.5 MB
         PointCloud2 streams at ~15 Hz plus odometry, images, and TF.
         Under CPU pressure (~91 %) a backlog of a few hundred RTPS
         fragments is common; 50 MB absorbs the burst without dropping
         fragments into the NACK/retransmission path.

         SocketSendBufferSize: 8 MB — the host publishes /fused_pointcloud
         (one merged cloud downstream), so send-side demand is modest.

         MaxQueuedRexmitBytes: 5 MB — hard ceiling on the retransmission
         backlog.  When CPU spikes cause a brief receive gap a naive
         unbounded queue can consume tens of MB of kernel buffer space and
         trigger a retransmission storm.  Capping at 5 MB forces CycloneDDS
         to drop the oldest rexmit requests when the queue fills, breaking
         the positive-feedback spiral.
    ─────────────────────────────────────────────────────────────────────── -->
    <Internal>
      <SocketReceiveBufferSize min="50MB"/>
      <SocketSendBufferSize min="8MB"/>
      <MaxQueuedRexmitBytes>5MB</MaxQueuedRexmitBytes>
    </Internal>
  </Domain>
</CycloneDDS>
