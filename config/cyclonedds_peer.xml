<CycloneDDS>
  <Domain Id="0">
    <General>
      <Interfaces>
        <NetworkInterface address="10.42.0.1" />
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
      <MulticastRecvNetworkInterfaceAddresses>all</MulticastRecvNetworkInterfaceAddresses>
      <!--
        Prevent IP-level fragmentation.  16 KB keeps each UDP datagram
        well under the Ethernet MTU (~1500 bytes after headers).
      -->
      <FragmentSize>16384B</FragmentSize>
      <Transport>UDP</Transport>
    </General>
    <Discovery>
      <Peers>
        <Peer address="10.42.0.1"/>
        <Peer address="10.42.0.2"/>
      </Peers>
    </Discovery>
    <!-- ── Internal / socket buffer tuning ────────────────────────────────
         Uses the "min" attribute … the kernel may grant a larger buffer.
         Kernel grant = 2× min (double-buffering).

         SocketReceiveBufferSize: 8 MB holds one full PointCloud2 plus
         overhead from multiple subscribers (keyframe_buffer, fusion,
         record).  Jetson publishes ~15 Hz × 2 cameras ~ 30 clouds/s.

         SocketSendBufferSize: 8 MB for /fused_pointcloud from host.

         See: plans/2026-06-16-network-buffer-tuning-host-v2.md
    ─────────────────────────────────────────────────────────────────────── -->
    <Internal>
      <SocketReceiveBufferSize min="8MB"/>
      <SocketSendBufferSize min="8MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
